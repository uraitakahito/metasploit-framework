{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "rdbg",
      "name": "Debug: msfconsole",
      "request": "launch",
      "script": "${workspaceFolder}/msfconsole",
      "args": ["-y", "${workspaceFolder}/config/database.yml"],
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "rdbg",
      "name": "Debug: Current File",
      "request": "launch",
      "script": "${file}",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "rdbg",
      "name": "Debug: RSpec",
      "request": "launch",
      "command": "rspec",
      "script": "${file}",
      "cwd": "${workspaceFolder}"
    }
  ]
}
