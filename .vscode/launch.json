{
  "version": "0.2.0",
  "configurations": [
    //
    // このデバッグ手法を試す際は事前に `tasks.json` の `msfconsole (debug)` のタスクを起動する必要があります。
    // 詳細の手順は `DEBUG.md` を参照してください。
    //
    {
      "type": "rdbg",
      "name": "Attach: msfconsole",
      "request": "attach",

      //
      // port番号はrdbgの--portとあわせる必要があります。
      // tasks.jsonで定義されています。
      //   https://github.com/uraitakahito/metasploit-framework/blob/40d42840b98f6d01fd138f2fd33c9728f9d1c773/.vscode/tasks.json#L19
      //
      "debugPort": "localhost:38697",

      "localfs": true
    },

    {
      "type": "rdbg",
      "name": "Debug: Current File",
      "request": "launch",
      "script": "${file}",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "rdbg",
      "name": "Debug: RSpec",
      "request": "launch",
      "command": "rspec",
      "script": "${file}",
      "cwd": "${workspaceFolder}"
    }
  ]
}
