{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "rdbg",
      "name": "Attach: msfconsole",
      "request": "attach",
      "debugPort": "localhost:38697",
      "localfs": true
    },
    {
      "type": "rdbg",
      "name": "Debug: Current File",
      "request": "launch",
      "script": "${file}",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "rdbg",
      "name": "Debug: RSpec",
      "request": "launch",
      "command": "rspec",
      "script": "${file}",
      "cwd": "${workspaceFolder}"
    }
  ]
}
