# Dockerfile.dev - Development/Debug environment
FROM ruby:3.3.8-bookworm AS builder
LABEL maintainer="Rapid7"

# Development: include development and test groups (exclude only coverage)
ARG BUNDLER_CONFIG_ARGS="set force_ruby_platform 'true' set no-cache 'true' set system 'true' set without 'coverage'"
ARG BUNDLER_FORCE_CLEAN="false"
ENV APP_HOME=/usr/src/metasploit-framework
ENV TOOLS_HOME=/usr/src/tools
ENV BUNDLE_IGNORE_MESSAGES="true"
WORKDIR $APP_HOME

COPY Gemfile* metasploit-framework.gemspec Rakefile $APP_HOME/
COPY lib/metasploit/framework/version.rb $APP_HOME/lib/metasploit/framework/version.rb
COPY lib/metasploit/framework/rails_version_constraint.rb $APP_HOME/lib/metasploit/framework/rails_version_constraint.rb
COPY lib/msf/util/helper.rb $APP_HOME/lib/msf/util/helper.rb

RUN apt-get update && apt-get install -y --no-install-recommends \
      autoconf \
      bash \
      bison \
      build-essential \
      curl \
      ruby-dev \
      libssl-dev \
      libreadline-dev \
      libsqlite3-dev \
      libpq-dev \
      libffi-dev \
      libpcap-dev \
      libxml2-dev \
      libxslt1-dev \
      libyaml-dev \
      zlib1g-dev \
      libncurses-dev \
      git \
    && rm -rf /var/lib/apt/lists/* \
    && echo "gem: --no-document" > /etc/gemrc \
    && gem update --system \
    && bundle config $BUNDLER_CONFIG_ARGS \
    && bundle install --jobs=8 \
    && if [ "${BUNDLER_FORCE_CLEAN}" = "true" ]; then \
         bundle clean --force; \
       fi \
    && rm -rf /usr/local/bundle/cache \
    && chmod -R a+rX /usr/local/bundle

# Download Go binary instead of building from source
# (Debian's golang-go is too old to build Go 1.24)
ARG TARGETARCH
RUN mkdir -p $TOOLS_HOME/bin && \
    cd $TOOLS_HOME/bin && \
    curl -OL https://go.dev/dl/go1.24.0.linux-${TARGETARCH}.tar.gz && \
    tar -xzf go1.24.0.linux-${TARGETARCH}.tar.gz && \
    rm go1.24.0.linux-${TARGETARCH}.tar.gz

##########################################################################

FROM ruby:3.3.8-bookworm
LABEL maintainer="Rapid7"
ARG TARGETARCH
ARG user_name=developer
ARG user_id
ARG group_id
ARG features_repository="https://github.com/uraitakahito/features.git"
ARG dotfiles_repository="https://github.com/uraitakahito/dotfiles.git"

ENV APP_HOME=/usr/src/metasploit-framework
ENV TOOLS_HOME=/usr/src/tools
ENV NMAP_PRIVILEGED=""
ENV METASPLOIT_GROUP=metasploit

#
# Git
#
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

#
# clone features
#
RUN cd /usr/src && \
  git clone --depth 1 ${features_repository}

#
# Add user and install common utils.
#
RUN USERNAME=${user_name} \
    USERUID=${user_id} \
    USERGID=${group_id} \
    CONFIGUREZSHASDEFAULTSHELL=true \
    UPGRADEPACKAGES=false \
      /usr/src/features/src/common-utils/install.sh

RUN groupadd -f $METASPLOIT_GROUP

# Add developer user to metasploit group for gem write access
RUN usermod -aG ${METASPLOIT_GROUP} ${user_name}

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    bash \
    libsqlite3-0 \
    libsqlite3-dev \
    nmap \
    libpq5 \
    libpq-dev \
    python3 \
    python3-pip \
    python3-impacket \
    python3-requests \
    libncurses6 \
    libncurses-dev \
    libcap2-bin \
    gosu \
    build-essential \
    libssl-dev \
    libreadline-dev \
    libyaml-dev \
    libxml2-dev \
    libxslt1-dev \
    libpcap-dev \
    libffi-dev \
    zlib1g-dev \
    nasm \
    nodejs \
    npm \
    postgresql-client \
    ruby-dev \
    && rm -rf /var/lib/apt/lists/*

RUN \
    if [ "${TARGETARCH}" = "arm64" ]; \
    then apt-get update && apt-get install -y --no-install-recommends \
        gcc \
        libc6-dev \
        python3-dev \
        libffi-dev \
        && rm -rf /var/lib/apt/lists/*; \
    else apt-get update && apt-get install -y --no-install-recommends \
        gcc-mingw-w64 \
        && rm -rf /var/lib/apt/lists/*; \
    fi

RUN setcap cap_net_raw,cap_net_bind_service=+eip $(which ruby)
RUN setcap cap_net_raw,cap_net_bind_service=+eip $(which nmap)

COPY --from=builder /usr/local/bundle /usr/local/bundle
# Ensure cache directory exists and set permissions for metasploit group
RUN mkdir -p /usr/local/bundle/cache && \
    chown -R root:metasploit /usr/local/bundle && \
    chmod -R g+w /usr/local/bundle && \
    find /usr/local/bundle -type d -exec chmod g+s {} \;
# Note: Source code is mounted via docker-compose.dev.yml volume
# Only copy tools (Go environment) which is not volume-mounted
COPY --from=builder $TOOLS_HOME $TOOLS_HOME
RUN gem update --system

ENV GOPATH=$TOOLS_HOME/go
ENV GOROOT=$TOOLS_HOME/bin/go
ENV PATH=${PATH}:${GOPATH}/bin:${GOROOT}/bin

USER ${user_name}

#
# dotfiles
#
RUN cd /home/${user_name} && \
  git clone --depth 1 ${dotfiles_repository} && \
  dotfiles/install.sh

# Install Claude Code
RUN curl -fsSL https://claude.ai/install.sh | bash

WORKDIR $APP_HOME

ENTRYPOINT ["docker/entrypoint.dev.sh"]
# Note: CMD is specified in docker-compose.dev.yml
